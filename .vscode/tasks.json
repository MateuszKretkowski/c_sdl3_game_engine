{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build project",
            "type": "shell",
            // Uzywamy mingw32-make z ucrt64 (nie usr/bin/make z MSYS) - pasuje do tego samego
            // toolchaina co gcc i unika problemow z mieszaniem srodowisk MSYS/native
            "command": "C:\\msys64\\ucrt64\\bin\\mingw32-make.exe",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            // To pomoże VS Code zrozumieć błędy kompilacji
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}